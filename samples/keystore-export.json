     "Enabled": true, "RotationEnabled": true},
    {"KeyId": "pqc-pilot-key", "KeySpec": "ML_DSA_65", "KeyUsage": "SIGN_VERIFY",
     "Enabled": true, "RotationEnabled": true},
    {"KeyId": "decommissioned-legacy-key", "KeySpec": "RSA_2048", "KeyUsage": "SIGN_VERIFY",
     "Enabled": false, "RotationEnabled": false}
